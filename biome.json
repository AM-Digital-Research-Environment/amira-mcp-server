{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
  "files": {
    "includes": ["src/**", "scripts/**", "test/**", "!scripts/vendor", "!src/ui/land.json"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": { "noTemplateCurlyInString": "off" }
        }
      }
    },
    {
      "includes": ["src/ui/views/**"],
      "linter": {
        "rules": {
          "style": { "useTemplate": "off" },
          "complexity": { "useArrowFunction": "off", "useOptionalChain": "off" },
          "correctness": { "noInnerDeclarations": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    }
  ],
  "assist": { "enabled": false }
}
