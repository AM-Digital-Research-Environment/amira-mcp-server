# The esbuild bundles (server/) are fully self-contained — verified to run
# with node_modules absent — so the packed extension ships only the stdio
# bundle + the JSON snapshot. No node_modules, no native bindings,
# cross-platform. test/unit/packaging.test.mjs packs the REAL repository and
# fails on any entry outside its allowlist, so a new root file has to be
# either listed here or deliberately allowed there.
node_modules/

# The extension runs server/index.js only (manifest `server.entry_point`).
# http.js is the container/remote entry, lib.js the test library and
# fetchCli.js the build-time crawler: ~5 MB of dead weight inside the .mcpb.
server/http.js
server/lib.js
server/fetchCli.js

# Generated release archives must never be nested into a later bundle.
*.mcpb
amira-mcp-skill.zip

# Source & build config
src/
scripts/
tsconfig.json
*.ts
*.map

# Tests (the stdio/HTTP smoke tests live in test/smoke/)
test/

# Local caches
.census-cache/

# Dev metadata
.gitignore
.gitattributes
.agents/
.git/
.github/
.DS_Store
*.log
.env
.env.*
.claude/settings.local.json

# Repo-process docs — they describe contributing to the repo, not using the
# extension. CITATION.cff stays: citation metadata belongs with the artifact.
CONTRIBUTING.md
SECURITY.md
.zenodo.json
/docs/
/.editorconfig
/conformance-baseline.yml

# Container and MCP-registry files: the remote deployment, not the extension.
/Dockerfile
/.dockerignore
/server.json

# Keep in the bundle: manifest.json, package.json, icon.png, CITATION.cff, LICENSE, server/index.js, data/, README.md, ROADMAP.md, CHANGELOG.md, .claude/skills/ (companion skill)
