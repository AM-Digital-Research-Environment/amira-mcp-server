# Dependencies
node_modules/

# Build output (esbuild single-file bundle)
server/

# Packed artifacts (the .mcpb extension + the zipped companion skill) — both
# are built fresh by CI on release; never committed.
*.mcpb
amira-mcp-skill.zip

# Bundled data snapshot — regenerated by `npm run fetch-data`
# (kept out of git to keep the repo lean; the .mcpb still ships it)
data/

# Dev metadata
.DS_Store
*.log
.env
.env.*

# Local-only Claude settings (keep the skill, drop local config)
.claude/settings.local.json

# The companion skill has ONE source of truth: .claude/skills/amira-mcp/ — it is
# what CI zips into amira-mcp-skill.zip and what the .mcpb ships. `.agents/` is a
# local-only convenience so Codex finds the same skill at the path it looks in;
# .agents/skills/amira-mcp is a directory junction (mklink /J) pointing at the
# .claude/ copy, never a second set of files. Recreate it with:
#   cmd /c mklink /J ".agents\skills\amira-mcp" ".claude\skills\amira-mcp"
.agents/

# Census raw-page cache (scripts/census.mjs)
.census-cache/
