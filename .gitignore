# Dependencies
node_modules/

# Build output (esbuild single-file bundle)
server/

# Packed artifacts (the .mcpb extension + the zipped companion skill) — both
# are built fresh by CI on release; never committed.
*.mcpb
amira-mcp-skill.zip

# Bundled data snapshot — regenerated by `npm run fetch-data`
# (kept out of git to keep the repo lean; the .mcpb still ships it)
data/

# Dev metadata
.DS_Store
*.log
.env
.env.*

# Local-only Claude settings (keep the skill, drop local config)
.claude/settings.local.json

# Local Codex/agent skill copies are not release artifacts.
.agents/

# Census raw-page cache (scripts/census.mjs)
.census-cache/
