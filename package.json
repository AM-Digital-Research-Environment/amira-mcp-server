{
  "name": "amira-mcp-server-bundle",
  "version": "1.4.1",
  "description": "Node MCP server for the Africa Multiple research data (AMIRA collection on Omeka S), packaged as a Claude Desktop extension (.mcpb).",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "fetch-data": "npm run build && node server/fetchCli.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "clean": "rimraf server",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:live": "npm run build && node --test \"test/live/*.test.mjs\"",
    "smoke": "node smoke-test.mjs",
    "smoke:http": "node smoke-http-test.mjs",
    "start:http": "node server/http.js",
    "prepack-mcpb": "npm run clean && npm run typecheck && npm run test && npm run smoke && npm run smoke:http",
    "pack-mcpb": "mcpb pack . amira-mcp-server.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
