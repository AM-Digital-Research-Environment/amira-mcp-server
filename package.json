{
  "name": "amira-mcp-server-bundle",
  "version": "1.12.0",
  "description": "Node MCP server for AMIRA, the Africa Multiple research-data platform on Omeka S, packaged as a Claude Desktop extension (.mcpb).",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "license": "MIT",
  "author": {
    "name": "Frédérick Madore",
    "email": "frederick.madore@uni-bayreuth.de",
    "url": "https://orcid.org/0000-0003-0959-2092"
  },
  "contributors": [
    {
      "name": "Digital Research Environment, Africa Multiple Cluster of Excellence, University of Bayreuth",
      "url": "https://www.africamultiple.uni-bayreuth.de/"
    }
  ],
  "homepage": "https://data.africamultiple.uni-bayreuth.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AM-Digital-Research-Environment/amira-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/AM-Digital-Research-Environment/amira-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "amira",
    "africa-multiple",
    "african-studies",
    "digital-humanities",
    "research-data",
    "omeka-s",
    "bayreuth"
  ],
  "scripts": {
    "fetch-data": "npm run build && node server/fetchCli.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "clean": "rimraf server",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "test:live": "npm run build && node --test \"test/live/*.test.mjs\"",
    "smoke": "node smoke-test.mjs",
    "smoke:http": "node smoke-http-test.mjs",
    "weigh": "node scripts/weigh.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:manifest": "mcpb validate manifest.json",
    "start:http": "node server/http.js",
    "prepack-mcpb": "npm run clean && npm run typecheck && npm run test && npm run smoke && npm run smoke:http && npm run weigh -- --check && npm run validate:manifest",
    "pack-mcpb": "mcpb pack . amira-mcp-server.mcpb"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
