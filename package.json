{
  "name": "africa-multiple-mcp-server-bundle",
  "version": "0.1.0",
  "description": "Node MCP server for the Africa Multiple research data (amira dashboard), packaged as a Claude Desktop extension (.mcpb).",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "fetch-data": "node scripts/fetch_data.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "clean": "rimraf server",
    "smoke": "node smoke-test.mjs",
    "prepack-mcpb": "npm run clean && npm run typecheck && npm run build",
    "pack-mcpb": "mcpb pack . africa-multiple-mcp-server.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
