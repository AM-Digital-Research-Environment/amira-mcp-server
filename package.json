{
  "name": "amira-mcp-server-bundle",
  "version": "1.18.1",
  "description": "Node MCP server for AMIRA, the Africa Multiple research-data platform on Omeka S, packaged as a Claude Desktop extension (.mcpb).",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "license": "MIT",
  "author": {
    "name": "FrÃ©dÃ©rick Madore",
    "email": "frederick.madore@uni-bayreuth.de",
    "url": "https://orcid.org/0000-0003-0959-2092"
  },
  "contributors": [
    {
      "name": "Digital Research Environment, Africa Multiple Cluster of Excellence, University of Bayreuth",
      "url": "https://www.africamultiple.uni-bayreuth.de/"
    }
  ],
  "homepage": "https://data.africamultiple.uni-bayreuth.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AM-Digital-Research-Environment/amira-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/AM-Digital-Research-Environment/amira-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "amira",
    "africa-multiple",
    "african-studies",
    "digital-humanities",
    "research-data",
    "omeka-s",
    "bayreuth"
  ],
  "scripts": {
    "fetch-data": "npm run build && node server/fetchCli.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:strict": "node scripts/build.mjs --strict",
    "skills:check": "node scripts/skills.mjs --strict",
    "clean": "rimraf server",
    "test": "npm run build && node scripts/test.mjs unit",
    "test:live": "npm run build && node scripts/test.mjs live",
    "smoke": "node smoke-test.mjs",
    "smoke:http": "node smoke-http-test.mjs",
    "weigh": "node scripts/weigh.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "stamp-citation": "node scripts/stamp-citation.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "validate:manifest": "node scripts/mcpb.mjs validate manifest.json",
    "start:http": "node server/http.js",
    "prepack-mcpb": "npm run clean && npm run typecheck && npm run skills:check && npm run test && npm run smoke && npm run smoke:http && npm run weigh -- --check && npm run validate:manifest",
    "pack-mcpb": "node scripts/mcpb.mjs pack . amira-mcp-server.mcpb",
    "audit": "npm audit --audit-level=high",
    "preview:apps": "npm run build && node scripts/preview-apps.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "ignore": "^7.0.12",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
